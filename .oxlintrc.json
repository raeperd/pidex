{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "rules": {
    "eslint/complexity": "error"
  },
  "ignorePatterns": ["**/build/**", "**/dist/**"],
  "options": {
    "typeAware": false,
    "typeCheck": false
  }
}
