{
  "name": "@pidex/workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @pidex/web build && tsc6 -p tsconfig.build.json",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck",
    "dev": "pnpm build && electron dist/desktop/main.js",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "test": "pnpm build && playwright test",
    "typecheck": "tsc6 --noEmit && pnpm --filter @pidex/web typecheck"
  },
  "dependencies": {
    "effect": "4.0.0-beta.107"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.12.4",
    "electron": "44.4.3",
    "oxfmt": "0.60.0",
    "oxlint": "1.75.0",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@11.16.0"
}
