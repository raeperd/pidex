{
  "name": "@pidex/workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @pidex/web build",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck",
    "dev": "pnpm --filter @pidex/web dev",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "test": "vitest run",
    "typecheck": "pnpm --filter @pidex/web typecheck"
  },
  "devDependencies": {
    "oxfmt": "0.60.0",
    "oxlint": "1.75.0",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@11.16.0"
}
