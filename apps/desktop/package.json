{
  "name": "@pidex/desktop",
  "version": "0.0.0",
  "private": true,
  "description": "A focused desktop interface for Pi",
  "author": "RaeCheol Park",
  "files": [
    "assets",
    "dist"
  ],
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "package": "node scripts/package.mjs && electron-builder --projectDir .package/app --config ../../electron-builder.yml --mac --dir",
    "start": "electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@orpc/client": "1.14.8",
    "@pidex/api": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "electron": "41.5.0",
    "electron-builder": "26.15.6",
    "typescript": "catalog:"
  },
  "productName": "pidex"
}
